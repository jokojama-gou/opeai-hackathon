{
  "cli": {
    "version": "24.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "base": {
      "node": "22.20.0"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beats-deleted-hook-motherboard.trycloudflare.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
