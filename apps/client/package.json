{
  "name": "@hackathon/client",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@hackathon/api": "0.1.0",
    "expo": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node ../../scripts/build-pwa.mjs",
    "build:bundles": "expo export --platform all",
    "doctor": "expo-doctor",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "eas:device": "eas device:create",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:store": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:store": "eas build --platform ios --profile production",
    "build:ios:simulator": "eas build --platform ios --profile simulator"
  },
  "private": true
}
