{
  "name": "opeai-hackathon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/client",
    "packages/api-ts"
  ],
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "packageManager": "npm@10.9.3",
  "volta": {
    "node": "22.20.0",
    "npm": "10.9.3"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:docs": "node scripts/verify.mjs docs",
    "verify:ui": "node scripts/verify.mjs ui",
    "verify:tooling": "node scripts/verify.mjs tooling",
    "verify:backend": "node scripts/verify.mjs backend",
    "contracts:generate": "node contracts/schema.mjs && node contracts/generate-fixtures.mjs && node scripts/generate-contract-types.mjs",
    "test:contracts": "tsx --test contracts/contracts.test.ts packages/api-ts/src/*.test.ts",
    "test": "tsx --test contracts/contracts.test.ts packages/api-ts/src/*.test.ts apps/client/src/data/*.test.ts",
    "start": "npm run start --workspace @hackathon/client --",
    "start:tunnel": "npm run start:tunnel --workspace @hackathon/client --",
    "web": "npm run web --workspace @hackathon/client --",
    "android": "npm run android --workspace @hackathon/client --",
    "ios": "npm run ios --workspace @hackathon/client --",
    "typecheck": "npm run typecheck --workspace @hackathon/client",
    "build:web": "npm run build:web --workspace @hackathon/client",
    "build:bundles": "npm run build:bundles --workspace @hackathon/client",
    "doctor": "npm run doctor --workspace @hackathon/client",
    "eas:login": "npm run eas:login --workspace @hackathon/client --",
    "eas:init": "npm run eas:init --workspace @hackathon/client --",
    "eas:device": "npm run eas:device --workspace @hackathon/client --",
    "build:android:apk": "npm run build:android:apk --workspace @hackathon/client --",
    "build:android:store": "npm run build:android:store --workspace @hackathon/client --",
    "build:ios:preview": "npm run build:ios:preview --workspace @hackathon/client --",
    "build:ios:store": "npm run build:ios:store --workspace @hackathon/client --",
    "build:ios:simulator": "npm run build:ios:simulator --workspace @hackathon/client --",
    "verify:security": "node scripts/verify.mjs security",
    "security:scan": "node scripts/check-repository-secrets.mjs",
    "security:hooks": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "eas-cli": "24.3.0",
    "fake-indexeddb": "6.2.5",
    "json-schema-to-typescript": "15.0.4",
    "supabase": "2.117.0",
    "tsx": "4.23.13"
  }
}
