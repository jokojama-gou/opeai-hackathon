# Local Supabase only; keep actual values in services/backend/.env (Git ignored).
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_TICKET_SECRET=
# Name shown in the audio-transfer consent screen. Set the actual destination.
PC_DESTINATION_ID=
# Comma-separated exact Web origins. No wildcard.
CORS_ORIGINS=http://localhost:8081
# ASR and generation are disabled until their adapters and runtime settings exist.
