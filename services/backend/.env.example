# Local Supabase only; keep actual values in services/backend/.env (Git ignored).
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_TICKET_SECRET=
# Name shown in the audio-transfer consent screen. Set the actual destination.
PC_DESTINATION_ID=
# Comma-separated exact Web origins. No wildcard.
CORS_ORIGINS=http://localhost:8081
# ASR still requires provider selection and its adapter.
# Text generation stays disabled until EVERY setting below is explicitly set.
# Do not copy this switch to true until approved retention/budget/data are ready.
GENERATION_ENABLED=false
GENERATION_API_KEY=
GENERATION_MODEL=gpt-5-mini
GENERATION_DESTINATION_ID=
GENERATION_RETENTION_VERIFIED=false
GENERATION_RETENTION_DESCRIPTION=
GENERATION_MAX_INPUT_CHARS=
GENERATION_MAX_OUTPUT_CHARS=
GENERATION_MAX_OUTPUT_TOKENS=
GENERATION_TIMEOUT_SECONDS=
# One persistent spend ledger shared by every user and worker. No automatic reset.
GENERATION_BUDGET_ID=
GENERATION_BUDGET_MICRO_USD=
# Reserve the worst-case input + output charge per call, including reasoning.
GENERATION_RESERVATION_MICRO_USD=
